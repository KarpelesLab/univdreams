/target
**/*.rs.bk
Cargo.lock
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Scratch space for ad-hoc binaries under analysis (not committed).
/scratch

# External fixtures fetched by scripts/fetch-test-fixtures.sh
# from URLs listed in testdata/external/MANIFEST. The manifest
# itself is committed; the downloads are not.
/testdata/external/*
!/testdata/external/MANIFEST

# wasm-bindgen output for the playground site — regenerated by
# the Pages CI workflow. The directory + .gitkeep stay so the
# workflow has a known sink.
/site/wasm/*
!/site/wasm/.gitkeep
